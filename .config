# This is an empty file, please overwrite it after generating the .config file with the source code
CONFIG_PACKAGE_iptables-mod-conntrack-extra=y
CONFIG_PACKAGE_iptables-mod-iprange=y
CONFIG_PACKAGE_iptables-mod-socket=y
CONFIG_PACKAGE_iptables-mod-extra=y
CONFIG_PACKAGE_iptables-mod-tproxy=y
# CONFIG_PACKAGE_luci-theme-argone=y
# CONFIG_PACKAGE_luci-app-argone-config=y
CONFIG_PACKAGE_luci-theme-argon=y
CONFIG_PACKAGE_luci-app-argon-config=y
CONFIG_PACKAGE_luci-i18n-argon-config-zh-cn=y
CONFIG_PACKAGE_luci-app-passwall2=y
CONFIG_PACKAGE_luci-i18n-passwall2-zh-cn=y
CONFIG_PACKAGE_luci-app-passwall=y
CONFIG_PACKAGE_luci-i18n-passwall-zh-cn=y
CONFIG_PACKAGE_luci-app-poweroff=y
CONFIG_PACKAGE_luci-i18n-poweroff-zh-cn=y
# CONFIG_DEVEL=y
# CONFIG_CCACHE=y
CONFIG_PACKAGE_lighttpd=y
CONFIG_PACKAGE_lighttpd-mod-redirect=y
CONFIG_PACKAGE_lighttpd-mod-proxy=y
CONFIG_SING_BOX_WITH_ECH=n
# 基础目标配置
CONFIG_TARGET_x86=y
CONFIG_TARGET_x86_64=y
CONFIG_TARGET_x86_64_Generic=y

# 镜像格式 - 关键部分
# CONFIG_TARGET_ROOTFS_EXT4FS=y
CONFIG_TARGET_ROOTFS_SQUASHFS=y

# GRUB 引导配置
CONFIG_GRUB_IMAGES=y
CONFIG_GRUB_EFI_IMAGES=y
CONFIG_GRUB_CONSOLE=y
CONFIG_GRUB_SERIAL=""

# 分区大小（可选，按需调整）
CONFIG_TARGET_KERNEL_PARTSIZE=64
CONFIG_TARGET_ROOTFS_PARTSIZE=1024

# 压缩格式
CONFIG_TARGET_IMAGES_GZIP=y

# 包含内核到根文件系统
CONFIG_TARGET_ROOTFS_INCLUDE_KERNEL=y

# 其他常用选项
CONFIG_VMDK_IMAGES=n          # 不需要 vmdk 时关闭
CONFIG_QCOW2_IMAGES=n         # 不需要 qcow2 时关闭


